# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PFM_KEY=
# Post for Me account ids to leave out of the dashboard, comma-separated (optional)
PFM_EXCLUDE=
# Long random strings, e.g. `openssl rand -hex 32`
CRON_SECRET=
AGENT_TOKEN=
# Your team's name, shown in the dashboard and the Claude connector (optional, e.g. Acme Studio)
TEAM_NAME=
# Rules for Claude on which accounts to use, in plain sentences (optional), e.g.
# "Everywhere" means the Acme accounts. Kids content goes to Acme Kids only.
POSTING_RULES=
# 1 = no sign-in: anyone with the link can approve and publish. Leave empty for team sign-in.
OPEN_ACCESS=
# Optional: lets Publish now start Claude straight away instead of waiting for its next run.
# From claude.ai/code/routines > the routine > Edit > Trigger > + > API: copy the Fire URL, then Generate token.
CLAUDE_ROUTINE_URL=
CLAUDE_ROUTINE_TOKEN=
